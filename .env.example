# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Host directory with server data: postgres/, filetracker/ and settings.py.
SIO_DATA_DIR=/home/adam/sio2

# Host port the site is served on (http://<server>:<port>).
SIO_PORT=8888

# Database password, e.g. from: openssl rand -hex 24
# Postgres stores it only when the data directory is first initialized.
OIOIOI_DB_PASSWORD=

OIOIOI_TIMEZONE=Europe/Warsaw
