# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Host directory with server data: postgres/, filetracker/ and settings.py.
SIO_DATA_DIR=/home/adam/sio2

# Host port the site is served on (http://<server>:<port>).
SIO_PORT=8888

# Database password, e.g. from: openssl rand -hex 24
# Postgres stores it only when the data directory is first initialized.
OIOIOI_DB_PASSWORD=

OIOIOI_TIMEZONE=Europe/Warsaw

# Host address on which sioworkersd (7888) and filetracker (9999) are published
# for workers on other machines. Both are unauthenticated: use an address of
# an internal network interface, not a public one. Docker bypasses ufw, so a
# ufw rule alone does not protect 0.0.0.0. Default exposes them to this host only.
SIO_WORKERS_BIND=127.0.0.1
