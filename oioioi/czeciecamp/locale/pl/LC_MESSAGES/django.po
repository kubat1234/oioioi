msgid "Start (Day 0)"
msgstr "Początek (Dzień 0)"

msgid "Number of days after Day 0"
msgstr "Liczba dni po Dniu 0"

msgid "Day 1, Day 2, ... one round per day after Day 0."
msgstr "Dzień 1, Dzień 2, ... jedna runda na każdy dzień po Dniu 0."

msgid "Enter an ID."
msgstr "Podaj ID."

