msgstr "Dzień %(number)d"

msgid "Czecie panel"
msgstr "Panel Czecie"

msgid "Settings saved."
msgstr "Zapisano ustawienia."

msgid "Freeze time saved."
msgstr "Zapisano czas zamrożenia."

msgid "Added %(count)d participants."
msgstr "Dodano uczestników: %(count)d."

msgid "Rankings frozen for participants."
msgstr "Rankingi zamrożone dla uczestników."

msgid "Rankings unfrozen. Participants now see the final rankings."
msgstr "Rankingi odmrożone. Uczestnicy widzą teraz ostateczne rankingi."

msgid "Added %(name)s."
msgstr "Dodano: %(name)s."

